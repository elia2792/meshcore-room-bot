# ==============================================================================
# MeshCore Room & Station Bot - Configurazione Ambiente
# ==============================================================================

# 1. CONNESSIONE RADIO PRIMARIA (Heltec con firmware MeshCore Companion):
# ------------------------------------------------------------------------------
# OPZIONE A: Collegamento diretto via cavo USB (Consigliato per PC / Raspberry Pi)
# Su Linux/Raspberry usa: /dev/ttyUSB0 o /dev/ttyACM0
# Su Windows usa: COM3 (o la porta COM assegnata)
# Su macOS usa: /dev/cu.usbserial-xxx
HELTEC_SERIAL_PORT=/dev/ttyUSB0

# OPZIONE B: Collegamento via WiFi / Rete TCP
# Lascia HELTEC_SERIAL_PORT vuoto se colleghi la radio via WiFi TCP.
# HELTEC_SERIAL_PORT=
# HELTEC_TCP_HOST=192.168.1.100
# HELTEC_TCP_PORT=5000

# 2. SECONDA RADIO OPZIONALE (Room Server / Bacheca Stanza su USB):
# ------------------------------------------------------------------------------
# Se colleghi un secondo Heltec con firmware MeshCore Room Server via USB:
# ROOM_SERVER_SERIAL_PORT=/dev/ttyUSB1
ROOM_SERVER_SERIAL_PORT=

# 3. INTEGRAZIONE TELEGRAM (Opzionale):
# ------------------------------------------------------------------------------
# Crea un bot con @BotFather su Telegram per ricevere notifiche e messaggi LoRa.
# Ottieni il tuo Chat ID scrivendo a @userinfobot su Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. SERVER WEB & DATABASE:
# ------------------------------------------------------------------------------
PORT=8000
DB_PATH=room_messages.db
WEB_APP_URL=http://localhost:8000/app

# 5. FUNZIONALITÀ AVANZATE MESH (Rate Limiting & Admin via Radio):
# ------------------------------------------------------------------------------
# Nodi autorizzati ai comandi di amministrazione via radio (!admin stats, !admin advert, !reboot):
ADMIN_LORA_NODES=Elia,Admin

# PIN di sicurezza opzionale per eseguire comandi admin (es: !admin stats buscate o !reboot buscate):
ADMIN_LORA_PIN=buscate

# Rate-Limiter per canale RF (protezione saturazione airtime LoRa):
# Numero massimo di risposte bot per finestra temporale (default: max 5 risposte in 300 secondi / 5 minuti):
CHANNEL_RATE_LIMIT_MAX=5
CHANNEL_RATE_LIMIT_WINDOW=300
